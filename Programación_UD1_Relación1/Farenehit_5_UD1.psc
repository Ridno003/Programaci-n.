Algoritmo Fahrenheit
	// Escribir un programa que convierta un valor dado en grados Fahrenheit a grados Celsius. Recordar que 
	// la fórmula para la conversión es: C = (F-32)*5/9 
	
	//Datos de entrada
	Definir F Como Real
	
	//Datos de saliida
	Definir C Como Real
	
	// F <- 129.5
	
	Escribir "Introduce el valor en grados Fahrenheit:"
	Leer F
	
	C <- (F - 32) * 5 / 9

    Escribir "El valor en grados Celsius es: ", C


	
FinAlgoritmo
