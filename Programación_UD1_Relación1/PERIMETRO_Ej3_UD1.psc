Algoritmo Triangulo
	// Dados los catetos de un triángulo rectángulo, calcular su hipotenusa. 
	Escribir "Da el valor de la altura"
	Leer altura
	
	Escribir "Da el valor de la base"
	Leer base
    
    hipotenusa <- raiz(altura^2 + base^2)
	
    Escribir "La hipotenusa es: ", hipotenusa
	
FinAlgoritmo
