Algoritmo Media
	//  Calcular la media de tres números pedidos por teclado.


	Escribir "Inserta un valor"
	Leer num1
	
	Escribir "Inserta un valor"
	Leer num2
	
	Escribir "Inserta un valor"
	Leer num3
	
	promedio <- (num1 + num2 + num3) /3
	
	Escribir "La media de estos valores es: " promedio
FinAlgoritmo

